{
  "name": "curchestra",
  "version": "0.1.0",
  "description": "A cursor orchestra that builds a website's real DOM.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js"
    },
    "./preload.css": "./dist/preload.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prebuild": "node scripts/dist.mjs clean",
    "postbuild": "node scripts/dist.mjs css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:perf": "vitest run --config vitest.perf.config.ts && playwright test -c playwright.perf.config.ts --grep @perf --workers=1 --project=chromium",
    "bench": "node --experimental-strip-types bench/run.ts",
    "size": "size-limit",
    "dev": "vite --config examples/vite.config.ts",
    "sri": "node scripts/sri.mjs"
  },
  "license": "MIT",
  "author": "JoshLei",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.6",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
